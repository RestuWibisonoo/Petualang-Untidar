[gd_resource type="Resource" script_class="LootTable" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/resources/loot_table.gd" id="1_table"]
[ext_resource type="Script" path="res://scripts/resources/loot_drop_entry.gd" id="2_entry"]
[ext_resource type="Resource" path="res://resources/equipment/iron_sword.tres" id="3_sword"]
[ext_resource type="Resource" path="res://resources/items/health_potion.tres" id="4_potion"]
[ext_resource type="Resource" path="res://resources/items/slime_jelly.tres" id="5_jelly"]

[sub_resource type="Resource" id="SubResource_sword"]
script = ExtResource("2_entry")
item_data = ExtResource("3_sword")
drop_chance = 1.0
min_quantity = 1
max_quantity = 1
weight = 50

[sub_resource type="Resource" id="SubResource_potion"]
script = ExtResource("2_entry")
item_data = ExtResource("4_potion")
drop_chance = 1.0
min_quantity = 2
max_quantity = 3
weight = 50

[sub_resource type="Resource" id="SubResource_jelly"]
script = ExtResource("2_entry")
item_data = ExtResource("5_jelly")
drop_chance = 1.0
min_quantity = 3
max_quantity = 5
weight = 50

[resource]
script = ExtResource("1_table")
table_id = &"boss_gorgon_loot"
entries = [SubResource("SubResource_sword"), SubResource("SubResource_potion"), SubResource("SubResource_jelly")]
use_weighted_selection = false
weighted_roll_count = 1
