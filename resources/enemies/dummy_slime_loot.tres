[gd_resource type="Resource" script_class="LootTable" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/resources/loot_table.gd" id="1_table"]
[ext_resource type="Script" path="res://scripts/resources/loot_drop_entry.gd" id="2_entry"]
[ext_resource type="Resource" path="res://resources/items/slime_jelly.tres" id="3_jelly"]
[ext_resource type="Resource" path="res://resources/items/health_potion.tres" id="4_potion"]
[ext_resource type="Resource" path="res://resources/equipment/wooden_sword.tres" id="5_sword"]
[ext_resource type="Resource" path="res://resources/equipment/cloth_armor.tres" id="6_armor"]

[sub_resource type="Resource" id="SubResource_jelly"]
script = ExtResource("2_entry")
item_data = ExtResource("3_jelly")
drop_chance = 0.8
min_quantity = 1
max_quantity = 2
weight = 80

[sub_resource type="Resource" id="SubResource_potion"]
script = ExtResource("2_entry")
item_data = ExtResource("4_potion")
drop_chance = 0.35
min_quantity = 1
max_quantity = 1
weight = 35

[sub_resource type="Resource" id="SubResource_sword"]
script = ExtResource("2_entry")
item_data = ExtResource("5_sword")
drop_chance = 0.15
min_quantity = 1
max_quantity = 1
weight = 15

[sub_resource type="Resource" id="SubResource_armor"]
script = ExtResource("2_entry")
item_data = ExtResource("6_armor")
drop_chance = 0.1
min_quantity = 1
max_quantity = 1
weight = 10

[resource]
script = ExtResource("1_table")
table_id = &"dummy_slime_loot"
entries = [SubResource("SubResource_jelly"), SubResource("SubResource_potion"), SubResource("SubResource_sword"), SubResource("SubResource_armor")]
use_weighted_selection = false
weighted_roll_count = 1
